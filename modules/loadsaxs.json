{
    "moduleid"    : "loadsaxs"
    ,"label"      : "Load SAXS"
    ,"help"       : "Load SAXS data"
    ,"executable" : "loadsaxs.php"
#    ,"resource"   : "docker-local"
#    ,"dependencies" : [ 
#        { "base" : "python" }
#        ,{ "file" : "mass_load.py" }
# comment above 2 lines and uncomment 2 lines below for perl executable
#        { "base" : "perl" }
#        ,{ "cpan" : "JSON" }
#    ]
    ,"requireproject"  : "true"
    ,"loadfields"      : "loadsaxs_load.php"
    ,"panels" : [
        {
            "root" : {
                "label" : [
                    1,
                    1
                ],
                "data" : [
                    1,
                    2
                ],
                "gap" : "1px",
                "align" : "left",
                "size" : [
                    1,
                    "auto"
                ]
            }
        },
        {
            "header" : {
                "data" : [
                    2,
                    1
                ],
                "label" : [
                    1,
                    1
                ],
                "align" : "center",
                "gap" : "1px",
                "size" : [
                    "auto",
                    "auto"
                ],
                "location" : [
                    "next",
                    "full"
                ]
            }
        },
        {
            "body" : {
                "location" : [
                    "next",
                    "full"
                ],
                "size" : [
                    "auto",
                    [
                        1,
                        1
                    ]
                ]
            }
        },
        {
            "footer" : {
                "align" : "center",
                "size" : [
                    "auto",
                    "auto"
                ],
                "location" : [
                    "next",
                    "full"
                ],
                "data" : [
                    2,
                    1
                ],
                "label" : [
                    1,
                    1
                ]
            }
        },
        {
            "inputpanel" : {
                "parent" : "body",
                "location" : [
                    "next",
                    "full"
                ],
                "align" : "left",
                "size" : [
                    "auto",
                    [1,1]
                ]
            }
        },
        {
            "msgspanel" : {
                "parent" : "body",
                "location" : [
                    "next",
                    "full"
                ],
                "align" : "left",
                "size" : [
                    "auto",
                    [1,1]
                ]
            }
        }
        ,{
            "resultpanel" : {
                "align" : "left",
                "size" : [
                    "auto",
                    [ 1, 1 ]
                ],
                "location" : [
                    "next",
                    "full"
                ],
                "data" : [
                    1,
                    2
                ],
                "parent" : "body",
                "repeats" : {
                    "indent" : "10px"
                },
                "label" : [
                    1,
                    1
                ]
            }
        }
    ]
    ,"fields"   : [
        {
            "role"       : "input"
            ,"id"        : "module_header"
            ,"label"     : "Load SAXS data"
            ,"type"      : "label"
            ,"default"   : "header4"
            ,"prehline"  : "true"
            ,"posthline" : "true"
            ,"layout" : {
                "parent" : "header"
            }
        }
        ,{
            "role"              : "output"
            ,"id"               : "pname"
            ,"label"            : "Project name"
            ,"type"             : "text"
            ,"required"         : "true"
            ,"help"             : "Name for this project - only letters, numbers and underscores are allowed"
            ,"pattern"          : "[a-zA-Z0-9_]+"
            ,"specifiedproject" : ""
            ,"layout"     : {
                "parent" : "inputpanel"
            }

        }
        ,{
            "role"              : "output"
            ,"id"               : "desc"
            ,"label"            : "Description"
            ,"type"             : "textarea"
            ,"required"         : "true"
            ,"help"             : "Description information about this project"
            ,"layout"     : {
                "parent" : "inputpanel"
            }
        }
        ,{
            "role"       : "input"
            ,"id"        : "saxsiqfile"
            ,"label"     : "SAXS I(q) file"
            ,"type"      : "lrfile"
            ,"help"      : "N.B. the momentum transfer must be  <i>q</i> = 4&#x3c0;sin(&#x398;)/&#x3bb;"
            ,"required"  : "true"
            ,"layout" : {
                "parent" : "inputpanel"
            }
        }
        ,{
            "role"       : "input"
            ,"id"        : "saxsiq_in_nm"
            ,"label"     : "Turn on if I(q) data is in <strong>nm<sup>-1</sup></strong> units"
            ,"type"      : "checkbox"
            ,"help"      : "Turn on if your data are in <strong>nm<sup>-1</sup></strong> units"
            ,"layout" : {
                "parent" : "inputpanel"
            }
        }
        ,{
            "role"       : "input"
            ,"id"        : "saxsprfile"
            ,"label"     : "SAXS P(r) file <a target=_blank href=https://somo.chem.utk.edu/bayesapp>[compute using BayesApp]</a>"
            ,"type"      : "lrfile"
            ,"help"      : "You can use BayesApp to compute a P(r) from an I(q) or download ATSAS and use GNOM"
            ,"required"  : "true"
            ,"layout" : {
                "parent" : "inputpanel"
            }
        }
        ,{
            "role"       : "input"
            ,"id"        : "saxspr_in_nm"
            ,"label"     : "Turn on if P(r) data is in <strong>nm</strong> units"
            ,"type"      : "checkbox"
            ,"help"      : "Turn on if your P(r) data are in <strong>nm</strong> units"
            ,"layout" : {
                "parent" : "inputpanel"
            }
        }
        ,{
            "role"              : "output"
            ,"label"             : ""
            ,"type"              : "plotly"
            ,"id"                : "iqplot"
            ,"labelmargintop"    : "0.5rem"
            ,"layout"           : {
                "parent" : "resultpanel"
                ,"data" : [ 1, 1 ]
            }
        }
        ,{
            "role"              : "output"
            ,"label"            : ""
            ,"type"             : "plotly"
            ,"id"               : "prplot"
            ,"layout"           : {
                "parent" : "resultpanel"
                ,"data" : [ 0, 2 ]
            }
        }
        ,{
            "role"              : "output"
            ,"label"            : ""
            ,"type"             : "plotly"
            ,"id"               : "guinierplot"
            ,"layout"           : {
                "parent" : "resultpanel"
                ,"data" : [ 1, 1 ]
            }
        }
        ,{
            "role"       : "input"
            ,"id"        : "guinier_qmin"
            ,"label"     : "Guinier <i>q</i> min [&#8491;<sup>-1</sup>] (optional)"
            ,"type"      : "text"
            ,"help"      : "Lower q limit of the automatic Guinier range search. Empty = from the first point."
            ,"layout" : {
                "parent" : "resultpanel"
            }
        }
        ,{
            "role"       : "input"
            ,"id"        : "guinier_qmax"
            ,"label"     : "Guinier <i>q</i> max [&#8491;<sup>-1</sup>] (optional)"
            ,"type"      : "text"
            ,"help"      : "Upper q limit of the automatic Guinier range search. Empty = no limit beyond q&middot;R<sub>g</sub> max."
            ,"layout" : {
                "parent" : "resultpanel"
            }
        }
        ,{
            "role"       : "input"
            ,"id"        : "guinier_qrgmax"
            ,"label"     : "Guinier <i>q</i>&middot;<i>R<sub>g</sub></i> max (optional)"
            ,"type"      : "text"
            ,"help"      : "Maximum q&middot;R<sub>g</sub> at the end of the fitted range. Empty = 1.3. Use about 1.0 for elongated or flexible particles."
            ,"layout" : {
                "parent" : "resultpanel"
            }
        }
        ,{
            "role"       : "input"
            ,"id"        : "guinier_maxrelsd"
            ,"label"     : "Guinier: exclude points with relative error above (optional)"
            ,"type"      : "text"
            ,"help"      : "Points whose SD / I(q) exceeds this fraction (e.g. 0.1) are left out of the Guinier search, as ATSAS does with the leading noisy points. Empty = keep every point; noisy points carry little weight in the SD-weighted fit anyway."
            ,"layout" : {
                "parent" : "resultpanel"
            }
        }
        ,{
            "role"       : "input"
            ,"id"        : "saxs_rg_override"
            ,"label"     : "Experimental R<sub>g</sub> override [&#8491;] (optional)"
            ,"type"      : "text"
            ,"help"      : "Leave empty to use the automatic Guinier R<sub>g</sub> of the I(q) file. A value entered here is used instead in the R<sub>g</sub> plots of the final models; the automatic value is still computed and shown for reference."
            ,"layout" : {
                "parent" : "resultpanel"
            }
        }
    ]
}
